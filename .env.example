# ---------------- 面板 ----------------
# 面板映射到宿主机的端口
PANEL_PORT=8000

# 面板登录密码。留空 = 只允许本机 127.0.0.1 直连做初始化，其它来源一律 401。
# 改成强密码后再挂到网上，别停在 admin123。
PANEL_PASSWORD=change-me-please

# 容器内时区，面板里显示的「今日」等统计按这个时区算
TZ=Asia/Shanghai

# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# 值守模式：同一套代码起第二个实例时设 1，只开面板不跑机器人
# STANDBY=1

# ---------------- 出网（家宽 / NAS / 内网部署必看） ----------------
# 这个程序是「主动出去拉消息」的（getUpdates 长轮询），不需要公网 IP、
# 不需要端口映射、不需要 Lucky 之类的内网穿透。真正要通的是「出去」这一侧。
#
# 如果你所在的网络直连不了 api.telegram.org，把代理填在这里：
#   http://192.168.1.2:7890      Clash / mihomo 的 HTTP 端口
#   socks5://192.168.1.2:7891    Clash 的 SOCKS 端口
#   带账号密码：http://user:pass@192.168.1.2:7890
# 协议、端口都按你代理软件里显示的填，不用加引号。留空 = 直连。
# TG_PROXY=

# Telegram API 根地址。默认官方域名；如果你自建了反向代理 / 用了中转，
# 填到这里（结尾不要带 /bot 或 /）。例如：https://tg.example.com
# TG_API_ROOT=

# ---------------- 首次初始值（都可以留空，之后在面板里配） ----------------
# Bot Token 从 @BotFather 用 /newbot 获取
# BOT_TOKEN=

# AI 接口兼容 OpenAI 协议（DeepSeek / OpenAI / 硅基流动 / 本地 Ollama 都行）
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat

# AI 接口的出网代理，留空走直连。接口只对大陆开放而主机在境外时才需要填。
# AI_PROXY=